# Configuração local sem acesso a um projeto Firebase real.
APP_VARIANT=development
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-app-treino.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-app-treino
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-app-treino.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:android:demo

# Android Emulator acessa a máquina host por 10.0.2.2.
# No iOS Simulator, use http://127.0.0.1:9099.
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://10.0.2.2:9099
