{
  "name": "app-treino-mobile",
  "version": "0.3.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "doctor": "expo-doctor",
    "lint": "expo lint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.cjs --runInBand",
    "test:unit:coverage": "npm run test:unit -- --coverage",
    "firebase:cli": "node scripts/run-firebase-cli.cjs",
    "emulator:start": "npm run firebase:cli -- emulators:start --config ../firebase.json --project demo-app-treino --only auth,firestore",
    "emulator:seed": "node scripts/seed-firestore-emulator.cjs",
    "test:rules": "npm run firebase:cli -- emulators:exec --config ../firebase.test.json --project demo-app-treino --only firestore \"npm run test:rules:inside\"",
    "test:rules:inside": "jest --config jest.rules.config.cjs --runInBand",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit:coverage",
    "test:all": "npm run verify && npm run test:rules"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.90.21",
    "date-fns": "^4.1.0",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "firebase": "^12.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^24.10.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "expo-doctor": "^1.20.2",
    "firebase-tools": "^15.27.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "jest-util": "29.7.0",
    "node": "^24.19.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  }
}
