# Variantes válidas: development, staging e production.
APP_VARIANT=development

# Variáveis EXPO_PUBLIC_* são incorporadas ao bundle. Nunca salve segredos nelas.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional. Use somente no desenvolvimento local com Firebase Auth Emulator.
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=""
