# Variáveis VITE_* são públicas e entram no bundle. Nunca adicione segredos administrativos.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcionais para desenvolvimento local.
VITE_FIREBASE_AUTH_EMULATOR_URL=
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=
VITE_FIREBASE_STORAGE_EMULATOR_HOST=

# Somente no emulador: permite testar a interface sem configurar uma custom claim.
VITE_ADMIN_AUTH_BYPASS=false
